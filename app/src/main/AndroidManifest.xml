        <receiver
            android:name=".TheoDoiDonHangWidget"
            android:label="FOODIE - Theo dõi đơn hàng"
            android:exported="true">

            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_theo_doi_don_hang_info" />
