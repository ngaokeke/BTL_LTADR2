<?xml version="1.0" ?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="98dp"
    android:layout_marginBottom="9dp"
    android:background="@drawable/bg_admin_don_hang_card"
    android:elevation="1dp"
    android:paddingHorizontal="12dp"
    android:paddingVertical="9dp">
    <TextView
        android:id="@+id/txtAdminMaDonHang"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:fontFamily="@font/be_vietnam_pro"
        android:textColor="#080808"
        android:textSize="16sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/txtAdminTrangThaiDonHang"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/admin_don_hang_sample_code_1"/>
    <TextView
        android:id="@+id/txtAdminTrangThaiDonHang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:paddingHorizontal="13dp"
        android:paddingVertical="3dp"
        android:gravity="center"
        android:fontFamily="@font/be_vietnam_pro"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="#5F390D"
        android:background="@drawable/bg_admin_don_hang_cho_xac_nhan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/admin_don_hang_pending_label"/>
    <LinearLayout
        android:id="@+id/adminDonHangDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/adminDonHangDivider"
        app:layout_constraintTop_toBottomOf="@id/txtAdminMaDonHang"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:id="@+id/txtAdminThoiGianDonHang" style="@style/AdminDonHangDetail"
            android:drawableStart="@drawable/ic_admin_clock"
            android:text="@string/admin_don_hang_sample_time_1"/>
        <TextView
            android:id="@+id/txtAdminHinhThucDonHang" style="@style/AdminDonHangDetail"
            android:drawableStart="@drawable/ic_admin_delivery"
            android:text="@string/admin_don_hang_delivery"/>
        <TextView style="@style/AdminDonHangDetail"
            android:drawableStart="@drawable/ic_admin_order_store"
            android:drawableTint="#111111"
            android:text="@string/admin_don_hang_store"/>
    </LinearLayout>
    <View
        android:id="@+id/adminDonHangDivider"
        android:layout_width="1dp"
        android:layout_height="29dp"
        android:layout_marginEnd="10dp"
        android:background="#DDDDDD"
        app:layout_constraintEnd_toStartOf="@id/txtAdminTongTienDonHang"
        app:layout_constraintTop_toTopOf="@id/txtAdminTongTienDonHang"
        app:layout_constraintBottom_toBottomOf="@id/txtAdminTongTienDonHang"/>
    <TextView
        android:id="@+id/txtAdminTongTienDonHang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="100dp"
        android:gravity="end"
        android:fontFamily="@font/be_vietnam_pro"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#080808"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/adminDonHangDetails"
        app:layout_constraintBottom_toBottomOf="@id/adminDonHangDetails"
        android:text="@string/admin_don_hang_sample_total_1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
