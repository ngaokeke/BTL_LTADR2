<?xml version="1.0" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adminNguoiDungRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_admin_nguoi_dung">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">
        <ImageButton
            android:id="@+id/btnAdminNguoiDungQuayLai"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:padding="9dp"
            android:src="@drawable/ic_back_white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/admin_nguoi_dung_back"/>
        <TextView style="@style/AdminNguoiDungText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/admin_nguoi_dung_title"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>
        <ImageButton
            android:id="@+id/btnAdminNguoiDungThem"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:padding="7dp"
            android:src="@drawable/ic_admin_user_add"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/admin_nguoi_dung_add"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_admin_don_hang_pill">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:importantForAccessibility="no"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/edtAdminNguoiDungTimKiem"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:padding="0dp"
            android:background="@null"
            android:fontFamily="@font/be_vietnam_pro"
            android:textSize="15sp"
            android:textColor="#111111"
            android:textColorHint="#4C4C4C"
            android:hint="@string/admin_nguoi_dung_search"
            android:contentDescription="@string/admin_nguoi_dung_search"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="14dp">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tabAdminNguoiDungTatCa" style="@style/AdminNguoiDungTab"
            android:layout_weight="1.15"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_admin_uu_dai_tab_selected"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:text="@string/admin_nguoi_dung_tab_all"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tabAdminNguoiDungThanhVien" style="@style/AdminNguoiDungTab"
            android:layout_weight="1.35"
            android:layout_marginEnd="8dp"
            android:text="@string/admin_nguoi_dung_tab_member"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tabAdminNguoiDungVip" style="@style/AdminNguoiDungTab"
            android:layout_weight="0.95"
            android:text="@string/admin_nguoi_dung_tab_vip"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/scrollAdminNguoiDung"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:scrollbars="none"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:id="@+id/layoutAdminDanhSachNguoiDung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="11dp"
            android:paddingBottom="18dp">
            <LinearLayout
                android:id="@+id/cardAdminNguoiDung1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_admin_nguoi_dung_card">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_admin_user_avatar"
                    android:importantForAccessibility="no"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txtAdminNguoiDungTen1" style="@style/AdminNguoiDungText"
                        android:layout_width="match_parent"
                        android:textStyle="bold"
                        android:text="@string/admin_nguoi_dung_name_1"/>
                    <TextView
                        android:id="@+id/txtAdminNguoiDungSdt1" style="@style/AdminNguoiDungText"
                        android:layout_marginTop="3dp"
                        android:textColor="#4E4E4E"
                        android:text="@string/admin_nguoi_dung_phone_1"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/txtAdminNguoiDungHang1" style="@style/AdminNguoiDungBadge"
                    android:text="@string/admin_nguoi_dung_member"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/cardAdminNguoiDung2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_admin_nguoi_dung_card">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_admin_user_avatar"
                    android:importantForAccessibility="no"/>
                <LinearLayout
