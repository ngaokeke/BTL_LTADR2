<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_auth">
    <TextView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text=""
        android:textSize="14sp"
        android:textColor="#171717"
        android:fontFamily="@font/be_vietnam_pro"
        android:layout_gravity="end"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        app:drawableTopCompat="@drawable/ic_close_white"
        android:contentDescription="@string/activity_dang_nhap_btn_dong_contentdescription_4"
        android:id="@+id/btnDong" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="top"
            android:paddingHorizontal="22dp">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginTop="219dp"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:minHeight="286dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_thong_tin_giao_hang_6_text_4"
                        android:textSize="20sp"
                        android:textColor="#171717"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_thong_tin_giao_hang_7_text_4"
                        android:textSize="13sp"
                        android:textColor="#171717"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:paddingHorizontal="10dp" />
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:id="@+id/edtTenNguoiNhan"
                        android:hint="@string/activity_dang_nhap_edt_tai_khoan_hint_4"
                        android:inputType="textPersonName"
                        android:singleLine="true"
                        android:textSize="14sp"
                        android:textColor="#171717"
                        android:textColorHint="#A6A6A6"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:paddingHorizontal="20dp"
                        android:background="@drawable/bg_field"
                        android:layout_marginTop="10dp"
                        android:autofillHints="personName" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_thong_tin_giao_hang_9_text_3"
                        android:textSize="13sp"
                        android:textColor="#171717"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:layout_marginTop="6dp"
                        android:paddingHorizontal="10dp" />
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:id="@+id/edtSoDienThoai"
                        android:hint="@string/activity_dang_nhap_edt_tai_khoan_hint_4"
                        android:inputType="phone"
                        android:singleLine="true"
                        android:textSize="14sp"
                        android:textColor="#171717"
                        android:textColorHint="#A6A6A6"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:paddingHorizontal="20dp"
                        android:background="@drawable/bg_field"
                        android:layout_marginTop="10dp"
                        android:autofillHints="phone" />
                    <com.google.android.material.button.MaterialButton
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:id="@+id/btnHoanThanh"
                        android:text="@string/activity_thong_tin_giao_hang_btn_hoan_thanh_text_4"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:textAllCaps="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="24dp"
                        app:backgroundTint="#ED252B"
                        app:strokeWidth="0dp"
                        app:strokeColor="#FF8A8D"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
