<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9002B">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/btnDong"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:gravity="start|center_vertical"
                android:paddingStart="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍔"
                android:textSize="88sp"
                android:gravity="center"
                android:layout_marginTop="95dp"
                android:layout_marginBottom="-24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đặt hàng thành công"
                    android:textColor="#269B67"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="28dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mã đơn"
                        android:textColor="#555555"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/txtMaDon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#26110812345"
                        android:textColor="#B00035"
                        android:textStyle="bold"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/btnSaoChep"
                        android:layout_width="35dp"
                        android:layout_height="40dp"
                        android:text="▢"
                        android:textSize="25sp"
                        android:textColor="#555555"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tổng thanh toán"
                        android:textColor="#555555"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/txtTongThanhToan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="155.000 đ"
                        android:textColor="#222222"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Thanh toán bằng"
                        android:textColor="#555555"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/txtPhuongThuc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiền mặt"
                        android:textColor="#222222"
                        android:textSize="17sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="22dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <TextView
                        android:layout_width="35dp"
                        android:layout_height="wrap_content"
                        android:text="📍"
                        android:textSize="21sp" />

                    <TextView
                        android:id="@+id/txtDiaChi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Giao đến: Chưa cập nhật địa chỉ"
                        android:textColor="#444444"
                        android:textSize="16sp"
                        android:lineSpacingExtra="5dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:layout_width="35dp"
                        android:layout_height="wrap_content"
                        android:text="🏪"
                        android:textSize="21sp" />

                    <TextView
                        android:id="@+id/txtCuaHang"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cửa hàng: TAN MAI"
                        android:textColor="#444444"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:layout_width="35dp"
                        android:layout_height="wrap_content"
                        android:text="👤"
                        android:textSize="21sp" />

                    <TextView
                        android:id="@+id/txtNguoiNhan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Khách hàng  0000000000"
                        android:textColor="#444444"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnHuyDon"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="Hủy đơn hàng"
                    android:textColor="#B00035"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="32dp" />

                <TextView
                    android:id="@+id/btnVeTrangChu"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="Về trang chủ"
                    android:textColor="#B00035"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_nut_huy_don"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="12dp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hotline    19006778"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:gravity="center"
                android:layout_marginTop="24dp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
