<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="102dp"
    android:orientation="vertical"
    android:background="#FFFFFF">
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_weight="1"
        android:gravity="center">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:id="@+id/navTrangChu"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_nav_home"
                android:contentDescription="@string/view_bottom_navigation_4_contentdescription_3"
                android:scaleType="fitCenter" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_bottom_navigation_4_contentdescription_3"
                android:textSize="12sp"
                android:textColor="#171717"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:id="@+id/navThucDon"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_nav_thucdon"
                android:contentDescription="@string/view_bottom_navigation_7_contentdescription_3"
                android:scaleType="fitCenter" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_bottom_navigation_7_contentdescription_3"
                android:textSize="12sp"
                android:textColor="#171717"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:id="@+id/navGioHang"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_gio_hang"
                android:contentDescription="@string/activity_thuc_don_10_text_3"
                android:scaleType="fitCenter" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_thuc_don_10_text_3"
                android:textSize="12sp"
                android:textColor="#171717"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:id="@+id/navDonHang"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_nav_donhang"
                android:contentDescription="@string/activity_tai_khoan_btn_don_hang_text_3"
                android:scaleType="fitCenter" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_tai_khoan_btn_don_hang_text_3"
                android:textSize="12sp"
                android:textColor="#171717"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:id="@+id/navTaiKhoan"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_nav_taikhoan"
                android:contentDescription="@string/view_bottom_navigation_16_contentdescription_3"
                android:scaleType="fitCenter" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_bottom_navigation_16_contentdescription_3"
                android:textSize="12sp"
                android:textColor="#171717"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
