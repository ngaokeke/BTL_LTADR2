                android:id="@+id/tabAdminTatCa" style="@style/AdminDonHangTab"
                android:text="@string/admin_don_hang_sample_tab_all"
                android:textStyle="bold"
                android:background="@drawable/bg_admin_don_hang_tab_selected"
                android:textColor="#FFFFFF"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/tabAdminChoXacNhan" style="@style/AdminDonHangTab" android:text="@string/admin_don_hang_sample_tab_pending"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/tabAdminDangChuanBi" style="@style/AdminDonHangTab" android:text="@string/admin_don_hang_sample_tab_preparing"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/tabAdminDangGiao" style="@style/AdminDonHangTab" android:text="@string/admin_don_hang_sample_tab_shipping"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/tabAdminHoanThanh" style="@style/AdminDonHangTab" android:text="@string/admin_don_hang_sample_tab_completed"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/tabAdminDaHuy" style="@style/AdminDonHangTab" android:text="@string/admin_don_hang_sample_tab_cancelled"/>
        </LinearLayout>
