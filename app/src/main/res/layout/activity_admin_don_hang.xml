<?xml version="1.0" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adminDonHangRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_admin_don_hang">
    <LinearLayout
        android:id="@+id/adminDonHangHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#C91F29">
        <ImageButton
            android:id="@+id/btnAdminDonHangMenu"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_admin_menu"
            android:contentDescription="@string/admin_don_hang_menu"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:paddingVertical="8dp"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="@string/admin_don_hang_title"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>
        <ImageButton
            android:id="@+id/btnAdminDonHangMore"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_admin_more"
            android:contentDescription="@string/admin_don_hang_more"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:paddingHorizontal="14dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_admin_don_hang_pill">
            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:src="@drawable/ic_search"
                android:importantForAccessibility="no"/>
            <EditText
                android:id="@+id/edtAdminTimDonHang"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:padding="0dp"
                android:background="@null"
                android:fontFamily="@font/be_vietnam_pro"
                android:textSize="14sp"
                android:textColor="#171717"
                android:textColorHint="#5D5D5D"
                android:hint="@string/admin_don_hang_search"
                android:inputType="text"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"/>
        </LinearLayout>
        <ImageButton
            android:id="@+id/btnAdminLocDonHang"
            android:layout_width="40dp"
            android:layout_height="38dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/bg_admin_don_hang_pill"
            android:src="@drawable/ic_admin_filter"
            android:padding="11dp"
            android:contentDescription="@string/admin_don_hang_filter"/>
    </LinearLayout>
