<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- ẢNH SẢN PHẨM -->
                <ImageView
                    android:id="@+id/imgHinhAnh"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_margin="16dp"
                    android:scaleType="fitCenter"
                    android:background="#FFFFFF"
                    android:contentDescription="Ảnh sản phẩm" />

                <!-- TÊN VÀ GIÁ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp">

                    <TextView
                        android:id="@+id/txtTenMonAn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tên món"
                        android:textColor="#111111"
                        android:textStyle="bold"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:id="@+id/txtGiaMonAn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="145.000 đ"
                            android:textColor="#E9232B"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/txtGiaCu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="180.000 đ"
                            android:textColor="#999999"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- MÔ TẢ -->
                <TextView
                    android:id="@+id/txtMoTa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="Mô tả sản phẩm"
                    android:textColor="#333333"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="#777777" />

                <!-- DANH SÁCH NHÓM TÙY CHỌN -->
                <LinearLayout
                    android:id="@+id/llNhomTuyChon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />

                <!-- SỐ LƯỢNG COMBO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:background="@drawable/bg_bo_tron_tang_giam_soluong">

                        <TextView
                            android:id="@+id/btnGiamSoLuong"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="-"
                            android:textColor="#222222"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/txtSoLuong"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="#222222"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/btnTangSoLuong"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="#222222"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- THANH ĐẶT HÀNG CỐ ĐỊNH DƯỚI ĐÁY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/txtTietKiem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Bạn tiết kiệm được 0 đ sau khi giảm giá."
                android:textColor="#222222"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnThemGioHang"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_bo_tron_them_gio_hang"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Thêm giỏ hàng: 145.000 đ"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- NÚT TRÁI TIM YÊU THÍCH -->
    <TextView
        android:id="@+id/btnYeuThich"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_nut_tron_trang"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:gravity="center"
        android:text="♡"
        android:textColor="#333333"
        android:textSize="22sp" />

    <!-- NÚT DẤU X ĐÓNG TRANG -->
    <TextView
        android:id="@+id/btnQuayLai"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_nut_tron_trang"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:gravity="center"
        android:text="✕"
        android:textColor="#222222"
        android:textSize="18sp" />
</FrameLayout>