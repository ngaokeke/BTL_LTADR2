<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_monan">

    <ImageView
        android:id="@+id/imgMonAn"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/txtTenMonAn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yêu thương 1"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtGiaMonAn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="145.000 đ"
            android:textColor="#444444"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtGiaCu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="180.000 đ"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnCong"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:gravity="center"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="23sp"
        android:textStyle="bold"
        android:background="@drawable/bg_nut_cong"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>