<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dang_nhap">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#D71920">

        <ImageView
            android:id="@+id/btnQuayLai"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:padding="7dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GIAO HÀNG ĐẾN"
                android:textColor="#FFE0E0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/txtDiaChi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="96 Định Công, Hoàng Mai..."
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnSuaDiaChi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sửa"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- SEARCH -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="7dp"
        android:background="#D71920">

        <EditText
            android:id="@+id/edtTimKiem"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nut_tron_trang"
            android:hint="Tìm món ăn..."
            android:textColor="#222222"
            android:textColorHint="#888888"
            android:textSize="13sp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/btnTimKiem"
            android:layout_width="55dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="Tìm"
            android:textColor="#D71920"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_nut_tron_trang"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- SORT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sắp xếp:"
            android:textColor="#333333"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spSapXep"
            android:layout_width="190dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- TITLE -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:paddingStart="15dp"
        android:text="THỰC ĐƠN"
        android:textColor="#D71920"
        android:textStyle="bold"
        android:textSize="18sp" />

    <!-- FOOD LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDanhSachMonAn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp" />

    <!-- CART BAR -->
    <LinearLayout
        android:id="@+id/btnGioHang"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="#D71920"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/txtSoMon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Giỏ hàng"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtTongTien"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 đ"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="5dp">

        <LinearLayout
            android:id="@+id/navTrangChu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_home"
                android:contentDescription="Trang chủ" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trang chủ"
                android:textSize="10sp"
                android:textColor="#777777" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navThucDon"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_nav_selected">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_thucdon"
                android:contentDescription="Thực đơn" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thực đơn"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#D71920" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navGioHang"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_gio_hang"
                android:contentDescription="Giỏ hàng" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giỏ hàng"
                android:textSize="10sp"
                android:textColor="#777777" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navDonHang"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_donhang"
                android:contentDescription="Đơn hàng" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đơn hàng"
                android:textSize="10sp"
                android:textColor="#777777" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTaiKhoan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_taikhoan"
                android:contentDescription="Tài khoản" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tài khoản"
                android:textSize="10sp"
                android:textColor="#777777" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
