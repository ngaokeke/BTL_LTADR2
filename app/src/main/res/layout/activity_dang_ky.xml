<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dang_nhap">

    <ImageView
        android:id="@+id/imgLogoDangKy"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="55dp"
        android:src="@drawable/logo_foodie"
        android:scaleType="fitCenter"
        android:contentDescription="Logo Foodie" />

    <TextView
        android:id="@+id/btnDongDangKy"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_gravity="top|end"
        android:gravity="center"
        android:text="×"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="245dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/bg_card_dang_nhap"
        android:elevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thông tin giao hàng"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên người nhận hàng"
            android:textColor="#333333"
            android:textSize="12sp"
            android:layout_marginStart="3dp" />

        <EditText
            android:id="@+id/edtTenNguoiNhan"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_input_dang_nhap"
            android:hint="Vui lòng nhập..."
            android:paddingStart="20dp"
            android:paddingEnd="15dp"
            android:textSize="12sp"
            android:singleLine="true"
            android:inputType="textPersonName" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Số điện thoại"
            android:textColor="#333333"
            android:textSize="12sp"
            android:layout_marginStart="3dp" />

        <EditText
            android:id="@+id/edtSoDienThoaiDangKy"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_input_dang_nhap"
            android:hint="Vui lòng nhập..."
            android:paddingStart="20dp"
            android:paddingEnd="15dp"
            android:textSize="12sp"
            android:singleLine="true"
            android:inputType="phone"
            android:maxLength="10" />

        <Button
            android:id="@+id/btnHoanThanhDangKy"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_dang_nhap"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:text="Hoàn thành"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

    </LinearLayout>

</FrameLayout>
