<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:paddingHorizontal="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tiêu đề trang -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnQuayLai"
                    android:layout_width="38dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_back_dark"
                    android:contentDescription="Quay lại"
                    android:scaleType="fitCenter"
                    android:padding="7dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Địa chỉ của tôi"
                    android:textSize="15sp"
                    android:textColor="#ED252B"
                    android:textStyle="bold"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:layout_marginStart="2dp" />

            </LinearLayout>

            <!-- Thẻ địa chỉ -->
            <LinearLayout
                android:id="@+id/cardDiaChi"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="vertical"
                android:background="@drawable/bg_address_card"
                android:padding="12dp"
                android:layout_marginTop="10dp">

                <!-- Dòng tên và nút sửa -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_nav_home"
                        android:contentDescription="Địa chỉ nhà"
                        android:scaleType="fitCenter"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/txtTenDiaChi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tên Khách Hàng"
                        android:textSize="14sp"
                        android:textColor="#171717"
                        android:textStyle="bold"
                        android:fontFamily="@font/be_vietnam_pro" />

                    <TextView
                        android:id="@+id/txtMacDinh"
                        android:layout_width="62dp"
                        android:layout_height="22dp"
                        android:text="Mặc định"
                        android:textSize="10sp"
                        android:textColor="#269B67"
                        android:gravity="center"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:background="@drawable/bg_default_address"
                        android:layout_marginStart="6dp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/btnSuaDiaChi"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_edit"
                        android:contentDescription="Sửa địa chỉ"
                        android:scaleType="fitCenter"
                        android:padding="4dp" />

                </LinearLayout>

                <!-- Nội dung địa chỉ -->
                <TextView
                    android:id="@+id/txtDiaChi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phố Tân Mai, Hoàng Mai, Hà Nội, Việt Nam"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:layout_marginStart="36dp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
