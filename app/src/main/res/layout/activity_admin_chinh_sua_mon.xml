<?xml version="1.0" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adminChinhSuaMonRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#D51D25">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">
        <ImageButton
            android:id="@+id/btnAdminCsmQuayLai"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:padding="8dp"
            android:src="@drawable/ic_back_white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/admin_csm_back"/>
        <TextView
            android:id="@+id/txtAdminCsmTitle" style="@style/AdminChinhSuaMonLabel"
            android:text="@string/admin_csm_title"
            android:layout_marginStart="16dp"
            android:textSize="22sp"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_admin_chinh_sua_mon_panel">
        <ScrollView
            android:id="@+id/scrollAdminChinhSuaMon"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="17dp"
                android:paddingBottom="4dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="153dp">
                    <ImageView
                        android:id="@+id/imgAdminCsmMon"
                        android:layout_width="220dp"
                        android:layout_height="145dp"
                        android:layout_gravity="center"
                        android:src="@drawable/yeu_thuong1"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/admin_csm_image"/>
                    <ImageButton
                        android:id="@+id/btnAdminCsmDoiAnh"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:translationX="80dp"
                        android:translationY="40dp"
                        android:padding="10dp"
                        android:elevation="2dp"
                        android:src="@drawable/ic_admin_camera"
                        android:background="@drawable/bg_admin_chinh_sua_mon_camera"
                        android:contentDescription="@string/admin_csm_change_image"/>
                </FrameLayout>
                <TextView
                    android:id="@+id/lblAdminCsmTenMon" style="@style/AdminChinhSuaMonLabel"
                    android:text="@string/admin_csm_name_label"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edtAdminCsmTenMon" style="@style/AdminChinhSuaMonInput"
                    android:text="@string/admin_csm_name"
                    android:contentDescription="@string/admin_csm_name_label"
                    android:inputType="textCapSentences"/>
                <TextView
                    android:id="@+id/lblAdminCsmDanhMuc" style="@style/AdminChinhSuaMonLabel"
                    android:text="@string/admin_csm_category_label"
                    android:layout_marginTop="12dp"/>
                <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                    android:id="@+id/edtAdminCsmDanhMuc" style="@style/AdminChinhSuaMonInput"
                    android:text="@string/admin_csm_category"
                    android:inputType="none"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:clickable="true"
                    android:drawableEnd="@drawable/ic_expand"
                    android:drawablePadding="8dp"
                    android:contentDescription="@string/admin_csm_category_label"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="18dp">
                        <TextView
                            android:id="@+id/lblAdminCsmGiaBan" style="@style/AdminChinhSuaMonLabel"
                            android:text="@string/admin_csm_price_label"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="37dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_admin_chinh_sua_mon_field"
                            android:paddingHorizontal="13dp"
                            android:gravity="center_vertical">
                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/edtAdminCsmGiaBan" style="@style/AdminChinhSuaMonInput"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginTop="0dp"
                                android:paddingHorizontal="0dp"
                                android:paddingVertical="0dp"
                                android:background="@null"
                                android:inputType="numberDecimal"
                                android:maxLines="1"
                                android:text="@string/admin_csm_price"
                                android:contentDescription="@string/admin_csm_price_label"/>
                            <TextView style="@style/AdminChinhSuaMonLabel"
                                android:layout_marginStart="4dp"
                                android:textSize="16sp"
                                android:textStyle="normal"
                                android:text="@string/admin_csm_currency"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/lblAdminCsmGiaGoc" style="@style/AdminChinhSuaMonLabel"
                            android:text="@string/admin_csm_original_price_label"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="37dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_admin_chinh_sua_mon_field"
                            android:paddingHorizontal="13dp"
                            android:gravity="center_vertical">
                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/edtAdminCsmGiaGoc" style="@style/AdminChinhSuaMonInput"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginTop="0dp"
                                android:paddingHorizontal="0dp"
                                android:paddingVertical="0dp"
                                android:background="@null"
                                android:inputType="numberDecimal"
                                android:maxLines="1"
                                android:text="@string/admin_csm_original_price"
                                android:contentDescription="@string/admin_csm_original_price_label"/>
                            <TextView style="@style/AdminChinhSuaMonLabel"
                                android:layout_marginStart="4dp"
                                android:textSize="16sp"
                                android:textStyle="normal"
                                android:text="@string/admin_csm_currency"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/lblAdminCsmMoTa" style="@style/AdminChinhSuaMonLabel"
                    android:text="@string/admin_csm_description_label"
                    android:layout_marginTop="12dp"/>
                <FrameLayout android:layout_width="match_parent" android:layout_height="66dp" android:layout_marginTop="6dp">
                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/edtAdminCsmMoTa" style="@style/AdminChinhSuaMonInput"
                        android:layout_height="match_parent"
                        android:layout_marginTop="0dp"
                        android:gravity="top|start"
                        android:paddingTop="8dp"
                        android:paddingBottom="12dp"
                        android:textSize="15sp"
                        android:singleLine="false"
                        android:inputType="textMultiLine|textCapSentences"
                        android:text="@string/admin_csm_description"
                        android:contentDescription="@string/admin_csm_description_label"/>
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="7dp"
                        android:src="@drawable/ic_admin_resize"
                        android:importantForAccessibility="no"/>
                </FrameLayout>
                <Space android:layout_width="match_parent" android:layout_height="10dp"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAdminCsmBanChay"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:checked="true"
                    android:text="@string/admin_csm_best_seller"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#0A0A0A"
                    android:thumb="@drawable/bg_admin_thuc_don_switch_thumb"
                    app:track="@drawable/bg_admin_thuc_don_switch_track"
                    app:thumbTint="@null"
                    app:trackTint="@null"
                    app:switchMinWidth="44dp"
                    app:switchPadding="12dp"
                    app:thumbTextPadding="0dp"
                    app:showText="false"
                    app:splitTrack="false"/>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E6E6E6"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAdminCsmConBan"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:checked="true"
                    android:text="@string/admin_csm_available"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#0A0A0A"
                    android:thumb="@drawable/bg_admin_thuc_don_switch_thumb"
                    app:track="@drawable/bg_admin_thuc_don_switch_track"
                    app:thumbTint="@null"
                    app:trackTint="@null"
                    app:switchMinWidth="44dp"
                    app:switchPadding="12dp"
                    app:thumbTextPadding="0dp"
                    app:showText="false"
                    app:splitTrack="false"/>
            </LinearLayout>
        </ScrollView>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAdminCsmLuu" style="@style/AdminThucDonTab"
            android:layout_width="match_parent"
            android:layout_height="49dp"
            android:layout_weight="0"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/bg_admin_ctdh_confirm"
            android:text="@string/admin_csm_save"
            android:textSize="19sp"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
