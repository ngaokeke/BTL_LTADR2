<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:background="#ED252B"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnQuayLai"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFF"
            android:contentDescription="Quay lại" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Giỏ hàng"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <View
            android:layout_width="45dp"
            android:layout_height="45dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- DANH SÁCH MÓN -->
            <LinearLayout
                android:id="@+id/llDanhSachMon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- ĐỊA CHỈ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="📍  Địa chỉ nhận hàng"
                android:textColor="#171717"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="15dp">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="⌂"
                    android:textColor="#222222"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/txtDiaChi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="96 Định Công, Hoàng Mai, Hà Nội"
                    android:textColor="#222222"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtSuaDiaChi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#555555"
                    android:textSize="30sp" />
            </LinearLayout>

            <!-- MÃ GIẢM GIÁ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="🏷  Mã giảm giá"
                android:textColor="#171717"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:padding="10dp">

                <EditText
                    android:id="@+id/edtMaGiamGia"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_o_nhap_gio_hang"
                    android:hint="Nhập mã giảm giá"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnApDungMa"
                    android:layout_width="105dp"
                    android:layout_height="55dp"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="#FFFFFF"
                    android:text="Áp dụng"
                    android:textColor="#ED252B"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- GHI CHÚ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="📝  Ghi chú đơn hàng"
                android:textColor="#171717"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="12dp">

                <EditText
                    android:id="@+id/edtGhiChu"
                    android:layout_width="match_parent"
                    android:layout_height="85dp"
                    android:background="@drawable/bg_o_nhap_gio_hang"
                    android:gravity="top"
                    android:hint="Ví dụ: Ít cay, không hành, giao hàng gọi trước..."
                    android:padding="12dp"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/swDungCu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:text="Lấy dụng cụ ăn uống"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- PHƯƠNG THỨC THANH TOÁN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="▣  Phương thức thanh toán"
                android:textColor="#171717"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgThanhToan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:paddingHorizontal="12dp">

                <RadioButton
                    android:id="@+id/rbMomo"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:buttonTint="#ED252B"
                    android:drawablePadding="10dp"
                    android:text="Ví MoMo"
                    android:textColor="#222222"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <RadioButton
                    android:id="@+id/rbZaloPay"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:buttonTint="#ED252B"
                    android:text="Ví ZaloPay"
                    android:textColor="#222222"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <RadioButton
                    android:id="@+id/rbQR"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:buttonTint="#ED252B"
                    android:text="Thanh toán bằng mã QR"
                    android:textColor="#222222"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <RadioButton
                    android:id="@+id/rbNganHang"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:buttonTint="#ED252B"
                    android:text="Chuyển khoản ngân hàng"
                    android:textColor="#222222"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <RadioButton
                    android:id="@+id/rbCOD"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:buttonTint="#ED252B"
                    android:checked="true"
                    android:text="Thanh toán khi nhận hàng (COD)"
                    android:textColor="#222222"
                    android:textSize="15sp" />

            </RadioGroup>

        </LinearLayout>
    </ScrollView>

    <!-- THANH TỔNG TIỀN VÀ ĐẶT HÀNG -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtSoSanPham"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tổng tiền (0 sản phẩm)"
                android:textColor="#171717"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTongTien"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 đ"
                android:textColor="#ED252B"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtTamTinh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Tạm tính: 0 đ" />

        <TextView
            android:id="@+id/txtPhiVanChuyen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Phí vận chuyển: 15.000 đ" />

        <Button
            android:id="@+id/btnDatHang"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#ED252B"
            android:text="Đặt hàng"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
