<?xml version="1.0" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adminThucDonRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#C91F29">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">
        <ImageButton
            android:id="@+id/btnAdminThucDonQuayLai"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_back_white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/admin_thuc_don_back"/>
        <TextView style="@style/AdminThucDonText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/admin_thuc_don_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_admin_thuc_don_panel">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingTop="16dp"
            android:paddingBottom="19dp">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/tabAdminThucDonTatCa" style="@style/AdminThucDonTab"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_admin_thuc_don_tab_selected"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:text="@string/admin_thuc_don_tab_all"/>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/tabAdminThucDonBanChay" style="@style/AdminThucDonTab"
                android:layout_marginEnd="8dp"
                android:text="@string/admin_thuc_don_tab_best_seller"/>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/tabAdminThucDonCombo" style="@style/AdminThucDonTab"
                android:text="@string/admin_thuc_don_tab_combo"/>
        </LinearLayout>
        <ScrollView
            android:id="@+id/scrollAdminThucDon"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none"
            android:clipToPadding="false">
            <LinearLayout
                android:id="@+id/layoutAdminDanhSachMon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingBottom="4dp">
                <LinearLayout
                    android:id="@+id/cardAdminThucDon1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="90dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_admin_thuc_don_card"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp">
                    <ImageView
                        android:id="@+id/imgAdminThucDon1"
                        android:layout_width="100dp"
                        android:layout_height="73dp"
                        android:layout_marginEnd="13dp"
                        android:src="@drawable/yeu_thuong1"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/admin_thuc_don_name_1"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="5dp">
                        <TextView
                            android:id="@+id/txtAdminThucDonTen1" style="@style/AdminThucDonText"
                            android:layout_width="match_parent"
                            android:textStyle="bold"
                            android:text="@string/admin_thuc_don_name_1"/>
                        <TextView
                            android:id="@+id/txtAdminThucDonGia1" style="@style/AdminThucDonText"
                            android:layout_marginTop="3dp"
                            android:textStyle="bold"
                            android:textColor="#E3131B"
                            android:text="@string/admin_thuc_don_price_1"/>
                        <TextView
                            android:id="@+id/txtAdminThucDonGiaCu1" style="@style/AdminThucDonText"
                            android:layout_marginTop="2dp"
                            android:textSize="14sp"
                            android:textColor="#A2A2A6"
                            android:text="@string/admin_thuc_don_old_price_1"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAdminThucDon1"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:padding="0dp"
                        android:checked="true"
                        android:thumb="@drawable/bg_admin_thuc_don_switch_thumb"
                        android:splitTrack="false"
                        android:contentDescription="@string/admin_thuc_don_toggle_1"
                        app:track="@drawable/bg_admin_thuc_don_switch_track"
                        app:thumbTint="@null"
                        app:trackTint="@null"
                        app:showText="false"
                        app:switchMinWidth="48dp"
                        app:thumbTextPadding="0dp"
                        app:switchPadding="0dp"
                        app:splitTrack="false"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/cardAdminThucDon2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="90dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_admin_thuc_don_card"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp">
                    <ImageView
                        android:id="@+id/imgAdminThucDon2"
                        android:layout_width="100dp"
                        android:layout_height="73dp"
                        android:layout_marginEnd="13dp"
                        android:src="@drawable/yeu_thuong2"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/admin_thuc_don_name_2"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="5dp">
                        <TextView
                            android:id="@+id/txtAdminThucDonTen2" style="@style/AdminThucDonText"
                            android:layout_width="match_parent"
                            android:textStyle="bold"
                            android:text="@string/admin_thuc_don_name_2"/>
                        <TextView
                            android:id="@+id/txtAdminThucDonGia2" style="@style/AdminThucDonText"
                            android:layout_marginTop="3dp"
                            android:textStyle="bold"
                            android:textColor="#E3131B"
                            android:text="@string/admin_thuc_don_price_2"/>
                        <TextView
                            android:id="@+id/txtAdminThucDonGiaCu2" style="@style/AdminThucDonText"
                            android:layout_marginTop="2dp"
                            android:textSize="14sp"
                            android:textColor="#A2A2A6"
                            android:text="@string/admin_thuc_don_old_price_2"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAdminThucDon2"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:padding="0dp"
                        android:checked="true"
                        android:thumb="@drawable/bg_admin_thuc_don_switch_thumb"
                        android:splitTrack="false"
                        android:contentDescription="@string/admin_thuc_don_toggle_2"
                        app:track="@drawable/bg_admin_thuc_don_switch_track"
                        app:thumbTint="@null"
                        app:trackTint="@null"
                        app:showText="false"
                        app:switchMinWidth="48dp"
                        app:thumbTextPadding="0dp"
                        app:switchPadding="0dp"
                        app:splitTrack="false"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/cardAdminThucDon3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="90dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_admin_thuc_don_card"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp">
                    <ImageView
                        android:id="@+id/imgAdminThucDon3"
                        android:layout_width="100dp"
                        android:layout_height="73dp"
                        android:layout_marginEnd="13dp"
                        android:src="@drawable/yeu_thuong3"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/admin_thuc_don_name_3"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="5dp">
                        <TextView
                            android:id="@+id/txtAdminThucDonTen3" style="@style/AdminThucDonText"
                            android:layout_width="match_parent"
                            android:textStyle="bold"
                            android:text="@string/admin_thuc_don_name_3"/>
                        <TextView
                            android:id="@+id/txtAdminThucDonGia3" style="@style/AdminThucDonText"
                            android:layout_marginTop="3dp"
                            android:textStyle="bold"
                            android:textColor="#E3131B"
                            android:text="@string/admin_thuc_don_price_3"/>
                        <TextView
                            android:id="@+id/txtAdminThucDonGiaCu3" style="@style/AdminThucDonText"
                            android:layout_marginTop="2dp"
                            android:textSize="14sp"
                            android:textColor="#A2A2A6"
                            android:text="@string/admin_thuc_don_old_price_3"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAdminThucDon3"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:padding="0dp"
                        android:checked="true"
                        android:thumb="@drawable/bg_admin_thuc_don_switch_thumb"
                        android:splitTrack="false"
                        android:contentDescription="@string/admin_thuc_don_toggle_3"
                        app:track="@drawable/bg_admin_thuc_don_switch_track"
                        app:thumbTint="@null"
                        app:trackTint="@null"
                        app:showText="false"
                        app:switchMinWidth="48dp"
                        app:thumbTextPadding="0dp"
                        app:switchPadding="0dp"
                        app:splitTrack="false"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/cardAdminThucDon4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="90dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_admin_thuc_don_card"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp">
                    <ImageView
                        android:id="@+id/imgAdminThucDon4"
                        android:layout_width="100dp"
                        android:layout_height="73dp"
                        android:layout_marginEnd="13dp"
                        android:src="@drawable/hanh_phuc1"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/admin_thuc_don_name_4"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="5dp">
                        <TextView
                            android:id="@+id/txtAdminThucDonTen4" style="@style/AdminThucDonText"
                            android:layout_width="match_parent"
                            android:textStyle="bold"
                            android:text="@string/admin_thuc_don_name_4"/>
                        <TextView
                            android:id="@+id/txtAdminThucDonGia4" style="@style/AdminThucDonText"
                            android:layout_marginTop="3dp"
                            android:textStyle="bold"
                            android:textColor="#E3131B"
                            android:text="@string/admin_thuc_don_price_4"/>
                        <TextView
                            android:id="@+id/txtAdminThucDonGiaCu4" style="@style/AdminThucDonText"
                            android:layout_marginTop="2dp"
                            android:textSize="14sp"
                            android:textColor="#A2A2A6"
                            android:text="@string/admin_thuc_don_old_price_4"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAdminThucDon4"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:padding="0dp"
                        android:checked="true"
                        android:thumb="@drawable/bg_admin_thuc_don_switch_thumb"
                        android:splitTrack="false"
                        android:contentDescription="@string/admin_thuc_don_toggle_4"
                        app:track="@drawable/bg_admin_thuc_don_switch_track"
                        app:thumbTint="@null"
                        app:trackTint="@null"
                        app:showText="false"
                        app:switchMinWidth="48dp"
                        app:thumbTextPadding="0dp"
                        app:switchPadding="0dp"
                        app:splitTrack="false"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/cardAdminThucDon5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="90dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_admin_thuc_don_card"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp">
                    <ImageView
                        android:id="@+id/imgAdminThucDon5"
                        android:layout_width="100dp"
                        android:layout_height="73dp"
                        android:layout_marginEnd="13dp"
                        android:src="@drawable/hanh_phuc2"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/admin_thuc_don_name_5"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="5dp">
                        <TextView
                            android:id="@+id/txtAdminThucDonTen5" style="@style/AdminThucDonText"
                            android:layout_width="match_parent"
                            android:textStyle="bold"
                            android:text="@string/admin_thuc_don_name_5"/>
                        <TextView
                            android:id="@+id/txtAdminThucDonGia5" style="@style/AdminThucDonText"
                            android:layout_marginTop="3dp"
                            android:textStyle="bold"
                            android:textColor="#E3131B"
                            android:text="@string/admin_thuc_don_price_5"/>
                        <TextView
                            android:id="@+id/txtAdminThucDonGiaCu5" style="@style/AdminThucDonText"
                            android:layout_marginTop="2dp"
                            android:textSize="14sp"
                            android:textColor="#A2A2A6"
                            android:text="@string/admin_thuc_don_old_price_5"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAdminThucDon5"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:padding="0dp"
                        android:checked="true"
                        android:thumb="@drawable/bg_admin_thuc_don_switch_thumb"
                        android:splitTrack="false"
                        android:contentDescription="@string/admin_thuc_don_toggle_5"
                        app:track="@drawable/bg_admin_thuc_don_switch_track"
                        app:thumbTint="@null"
                        app:trackTint="@null"
                        app:showText="false"
                        app:switchMinWidth="48dp"
                        app:thumbTextPadding="0dp"
                        app:switchPadding="0dp"
                        app:splitTrack="false"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdminThucDonThemMon" style="@style/AdminThucDonTab"
            android:layout_width="match_parent"
            android:layout_height="49dp"
            android:layout_weight="0"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_admin_ctdh_confirm"
            android:text="@string/admin_thuc_don_add"
            android:textSize="22sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="25dp"
            app:iconTint="#111111"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
    </LinearLayout>
</LinearLayout>
