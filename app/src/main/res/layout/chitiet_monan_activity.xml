<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:background="#E9232B">

                <TextView
                    android:id="@+id/btnQuayLai"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="‹"
                    android:textSize="38sp"
                    android:textColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="25dp"
                    android:layout_height="wrap_content"
                    android:text="⌖"
                    android:textSize="22sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtDiaChi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="96 Định Công, Hoàng Mai, Hà Nội"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✎"
                    android:textSize="22sp"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

            <!-- ẢNH SẢN PHẨM -->
            <ImageView
                android:id="@+id/imgHinhAnh"
                android:layout_width="match_parent"
                android:layout_height="205dp"
                android:layout_margin="12dp"
                android:scaleType="fitCenter"
                android:background="#FFFFFF"
                android:contentDescription="Ảnh sản phẩm" />

            <!-- SỐ NGƯỜI -->
            <TextView
                android:id="@+id/txtSoNguoi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:padding="5dp"
                android:text="♙ 3 người"
                android:textSize="10sp"
                android:textColor="#333333"
                android:background="#FFE5B4" />

            <!-- TÊN VÀ GIÁ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp">

                <TextView
                    android:id="@+id/txtTenMonAn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tên món"
                    android:textColor="#111111"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/txtGiaMonAn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="145.000 đ"
                        android:textColor="#E9232B"
                        android:textStyle="bold"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/txtGiaCu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="180.000 đ"
                        android:textColor="#999999"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- MÔ TẢ -->
            <TextView
                android:id="@+id/txtMoTa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="Mô tả sản phẩm"
                android:textColor="#333333"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="#777777" />

            <!-- DANH SÁCH NHÓM TÙY CHỌN -->
            <LinearLayout
                android:id="@+id/llNhomTuyChon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <!-- SỐ LƯỢNG COMBO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="#FFE0B2">

                    <TextView
                        android:id="@+id/btnGiamSoLuong"
                        android:layout_width="35dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="-"
                        android:textColor="#222222"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/txtSoLuong"
                        android:layout_width="35dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#222222"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnTangSoLuong"
                        android:layout_width="35dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="#222222"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- NÚT THÊM GIỎ HÀNG -->
    <TextView
        android:id="@+id/btnThemGioHang"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:background="#E9232B"
        android:text="Thêm giỏ hàng: 145.000 đ"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="17sp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
