                        <TextView
                            android:id="@+id/txtAdminUuDaiHanSuDung2" style="@style/AdminUuDaiText"
                            android:layout_marginTop="7dp"
                            android:drawableStart="@drawable/ic_admin_calendar"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:text="@string/admin_uu_dai_expiry_2"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAdminUuDai2"
                        android:layout_width="44dp"
                        android:layout_height="36dp"
                        android:checked="true"
                        android:padding="0dp"
                        android:thumb="@drawable/bg_admin_thuc_don_switch_thumb"
                        android:contentDescription="@string/admin_uu_dai_toggle_2"
                        app:track="@drawable/bg_admin_thuc_don_switch_track"
                        app:thumbTint="@null"
                        app:trackTint="@null"
                        app:switchMinWidth="44dp"
                        app:switchPadding="0dp"
                        app:thumbTextPadding="0dp"
                        app:showText="false"
                        app:splitTrack="false"/>
                </LinearLayout>
                <LinearLayout
