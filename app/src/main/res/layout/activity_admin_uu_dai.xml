                    <View
                        android:layout_width="1dp"
                        android:layout_height="56dp"
                        android:layout_marginHorizontal="11dp"
                        android:background="#E0E0E0"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtAdminUuDaiMa3" style="@style/AdminUuDaiText"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/admin_uu_dai_code_3"/>
                        <TextView
                            android:id="@+id/txtAdminUuDaiMoTa3" style="@style/AdminUuDaiText"
                            android:layout_marginTop="3dp"
                            android:text="@string/admin_uu_dai_description_3"/>
                        <TextView
                            android:id="@+id/txtAdminUuDaiHanSuDung3" style="@style/AdminUuDaiText"
                            android:layout_marginTop="7dp"
