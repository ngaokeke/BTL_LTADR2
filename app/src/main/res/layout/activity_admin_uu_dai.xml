                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:text="@string/admin_uu_dai_expiry_3"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAdminUuDai3"
                        android:layout_width="44dp"
                        android:layout_height="36dp"
                        android:checked="false"
                        android:padding="0dp"
                        android:thumb="@drawable/bg_admin_thuc_don_switch_thumb"
                        android:contentDescription="@string/admin_uu_dai_toggle_3"
                        app:track="@drawable/bg_admin_thuc_don_switch_track"
                        app:thumbTint="@null"
                        app:trackTint="@null"
                        app:switchMinWidth="44dp"
                        app:switchPadding="0dp"
                        app:thumbTextPadding="0dp"
                        app:showText="false"
                        app:splitTrack="false"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/cardAdminUuDai4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="89dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_admin_uu_dai_card"
                    android:elevation="1dp"
                    android:paddingHorizontal="14dp"
