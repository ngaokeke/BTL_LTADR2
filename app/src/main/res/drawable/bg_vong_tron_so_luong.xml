<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vòng tròn trắng bên ngoài -->
    <item>
        <shape
            android:shape="oval">
            <solid
                android:color="#E9232B" />
        </shape>
    </item>
    <!-- Vòng tròn đỏ bên trong -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape
            android:shape="oval">
            <solid
                android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
