<?xml version="1.0" encoding="utf-8"?>
<!-- Nền đỏ xuống trắng như bg_auth, với các mốc chuyển màu theo ảnh admin.
     Vector gradient hỗ trợ nhiều mốc màu và tự co giãn theo kích thước nền. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="360dp"
    android:height="720dp"
    android:viewportWidth="360"
    android:viewportHeight="720">

    <path android:pathData="M0,0 H360 V720 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="720"
                android:tileMode="clamp">
                <item android:offset="0" android:color="#BF1920" />
                <item android:offset="0.20" android:color="#C71C23" />
                <item android:offset="0.36" android:color="#CD222A" />
                <item android:offset="0.43" android:color="#E7767C" />
                <item android:offset="0.54" android:color="#F7D9DB" />
                <item android:offset="0.68" android:color="#FCF0F1" />
                <item android:offset="1" android:color="#FFFAFA" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
